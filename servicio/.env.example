# Plantilla de variables de entorno. Copiar a .env y rellenar los valores
# reales. .env esta en .gitignore y NUNCA debe subirse.
#
# IMPORTANTE: esta URI contiene usuario y contrasena de MongoDB Atlas.
# Si alguna vez se sube a un repositorio, hay que cambiar la contrasena en
# Atlas, no solo borrarla del archivo: ya quedo expuesta mientras estuvo
# escrita en application.properties.
SPRING_MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster.ejemplo.mongodb.net/proyecto_formativo?retryWrites=true&w=majority

# Django: token compartido para /api/internal/
DJANGO_BASE_URL=http://127.0.0.1:8000
INTERNAL_API_TOKEN=

# CORS del frontend
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
